# Red de seguridad para todo el repositorio. Cada proyecto (broker-api,
# broker-spa) tiene además su propio .gitignore.

# Credenciales y configuración local: NUNCA al repositorio.
.env
.env.*
!.env.example
*.pem
*.key
auth.json

# Dependencias y builds
node_modules/
vendor/
dist/
build/

# Logs y temporales
*.log
*.tmp
.phpunit.cache/
.phpunit.result.cache

# Bases de datos locales
*.sqlite
*.sqlite3

# Editores y sistema operativo
.vscode/
.idea/
.fleet/
.zed/
.DS_Store
Thumbs.db
