# ============================================================
# broker-api — variables de entorno
# ============================================================
# En Kubernetes NO existe este archivo: cada variable llega del
# Secret (broker-api-secrets) o del ConfigMap (broker-api-config).
# Cada bloque indica de dónde sale. Los valores de abajo sirven
# para desarrollo local con Laragon + Mailpit.
# ============================================================

# ---------- Secret: broker-api-secrets ----------
APP_KEY=
DB_PASSWORD=
# Firma de los JWT de la SPA. Generar con: php artisan jwt:secret
JWT_SECRET=
# Cuenta de correo (aplicaciones@ en QA y producción). Vacías en local: Mailpit no pide login.
MAIL_USERNAME=
MAIL_PASSWORD=

# ---------- ConfigMap: broker-api-config ----------
APP_NAME="Broker de Servicios"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8091
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

# En Kubernetes: LOG_CHANNEL=stderr (los logs del pod). En local, archivo.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=broker_api
DB_USERNAME=root

# API sin estado: no hay sesiones de servidor.
SESSION_DRIVER=array
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Origen de la SPA: único origen permitido por CORS (con credenciales)
SPA_URL=http://localhost:5173

# Sesión de la SPA, en minutos: access token, vida máxima e inactividad
JWT_ACCESS_TTL=15
JWT_REFRESH_TTL=480
JWT_INACTIVIDAD_TTL=30

# Cuenta de correo única del broker: las mismas variables que ya usan
# SGRH y GestionFestibal. En local apunta a Mailpit (bandeja en
# http://localhost:8025), así ningún correo sale de verdad.
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM_ADDRESS="aplicaciones@cultura.gob.do"
MAIL_FROM_NAME="Ministerio de Cultura"
# Dominio del saludo SMTP. Sin él sale «EHLO localhost», que Office 365 suele rechazar.
MAIL_EHLO_DOMAIN=cultura.gob.do

# QA y producción (Office 365): ver DESPLIEGUE.md
# MAIL_HOST=smtp.office365.com
# MAIL_PORT=587

# Peticiones por minuto que acepta /v1 de cada sistema
BROKER_PETICIONES_POR_MINUTO=120

# Límites del servicio de correo
BROKER_ENVIO_POR_MINUTO=30
BROKER_ADJUNTO_MAX_MB=20
BROKER_RETENCION_DIAS=90
